# Environment Variables for Smart Resort 360

# ============================================
# REQUIRED - NextAuth
# ============================================
NEXTAUTH_SECRET=smart-resort-360-super-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# OPTIONAL - AI (leave blank for demo mode)
# ============================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ============================================
# OPTIONAL - Weather API
# ============================================
# OPENWEATHER_API_KEY=...
# RESORT_LOCATION=Coorg,IN

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_RESORT_NAME="Azure Hills Resort"
NEXT_PUBLIC_DEMO_MODE=true
